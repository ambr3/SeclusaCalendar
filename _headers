# Security headers for Seclusa Calendar on static hosts that support `_headers`
# (Netlify, Cloudflare Pages). GitHub Pages does NOT support custom headers —
# for GitHub Pages, host the git repo and rely on the <meta> CSP as a fallback,
# or proxy through a service that can set headers.
# When a server sends a CSP header it takes precedence over the <meta> CSP.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: off
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), clipboard-read=(), clipboard-write=(), usb=(), midi=(), serial=(), display-capture=(), accelerometer=(), gyroscope=(), magnetometer=(), idle-detection=(), screen-wake-lock=()
  Cache-Control: no-cache

/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), clipboard-read=(), clipboard-write=(), usb=(), midi=(), serial=(), display-capture=(), accelerometer=(), gyroscope=(), magnetometer=(), idle-detection=(), screen-wake-lock=()
  Cache-Control: no-cache

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache